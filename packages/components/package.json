{
  "name": "@ahead-ui/components",
  "version": "0.0.1",
  "description": "Adaptive, accessible React components for Ahead UI",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./slot": {
      "types": "./dist/slot/index.d.ts",
      "import": "./dist/slot/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js"
    },
    "./card": {
      "types": "./dist/card/index.d.ts",
      "import": "./dist/card/index.js"
    },
    "./badge": {
      "types": "./dist/badge/index.d.ts",
      "import": "./dist/badge/index.js"
    },
    "./spinner": {
      "types": "./dist/spinner/index.d.ts",
      "import": "./dist/spinner/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "import": "./dist/switch/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "import": "./dist/checkbox/index.js"
    },
    "./avatar": {
      "types": "./dist/avatar/index.d.ts",
      "import": "./dist/avatar/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "import": "./dist/tooltip/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "import": "./dist/dialog/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ahead-ui/core": "workspace:*",
    "@react-aria/button": "^3.9.3",
    "@react-aria/checkbox": "^3.14.1",
    "@react-aria/dialog": "^3.5.12",
    "@react-aria/focus": "^3.16.2",
    "@react-aria/interactions": "^3.21.1",
    "@react-aria/overlays": "^3.22.0",
    "@react-aria/switch": "^3.6.2",
    "@react-aria/tooltip": "^3.7.2",
    "@react-aria/utils": "^3.23.2",
    "@react-aria/visually-hidden": "^3.8.10",
    "@react-stately/toggle": "^3.7.2",
    "@react-stately/tooltip": "^3.4.9",
    "@react-types/button": "^3.9.2",
    "@react-types/shared": "^3.22.1",
    "class-variance-authority": "^0.7.0",
    "framer-motion": "^11.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
